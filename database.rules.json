{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "$roomId.matches(/^[A-Z0-9_-]{1,12}$/)",
        ".write": "$roomId.matches(/^[A-Z0-9_-]{1,12}$/)",
        "data": {
          ".validate": "newData.isString() && newData.val().length < 100000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "ipo_rooms": {
      "$roomId": {
        ".read": "$roomId.matches(/^[A-Z0-9]{2,24}$/)",
        ".write": "$roomId.matches(/^[A-Z0-9]{2,24}$/)",
        "data": {
          ".validate": "newData.isString() && newData.val().length < 1000000"
        },
        "online": {
          "$cid": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
